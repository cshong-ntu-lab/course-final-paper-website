rules_version = '2';

// Web SDK upload model: students upload directly to
//   reports/{reportId}/{uid}/{filename}
// gated by the user's Firebase Auth identity. The server records each upload
// in Firestore via /api/uploads/finalize after the client confirms the PUT.
//
// Reads are public — image URLs are embedded in publicly-readable markdown.
// (Token-based URLs from getDownloadURL still work either way.)

service firebase.storage {
  match /b/{bucket}/o {
    // Public read of any uploaded report asset. Tokens further gate access at
    // the URL level for direct downloads.
    match /reports/{reportId}/{uid}/{filename=**} {
      allow read: if true;
      allow write:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(png|jpeg|webp|gif|svg\\+xml)')
          || request.resource.contentType == 'text/csv'
          || request.resource.contentType == 'application/json'
          // Student HTML pages (docs/html-artifact-embed.md). Must be served as
          // a download so the raw Storage URL never renders the page; the
          // site embeds it via a sandboxed srcdoc iframe instead.
          || (
            request.resource.contentType == 'text/html'
            && request.resource.contentDisposition != null
            && request.resource.contentDisposition.matches('attachment.*')
          )
        );
    }

    // User avatar images — each user can only write under their own uid.
    match /avatars/{uid}/{filename} {
      allow read: if true;
      allow write:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // Default deny for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
