# Runtime mode — set to "staging" on the staging Cloud Run service, omit/"production" elsewhere.
APP_MODE=production

# Comma-separated list of teacher emails (granted isAdmin custom claim on login).
ADMIN_EMAILS=teacher@example.com

# ──────────────────────────────────────────────────────────────
# Firebase client (Web SDK) — exposed to browser, NEXT_PUBLIC prefix required.
# Find these at Firebase Console > Project Settings > General > Your apps > Web.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ──────────────────────────────────────────────────────────────
# Firebase Admin SDK — server only.
#
# Preferred (and required when org policy blocks SA key creation):
#   LEAVE THIS EMPTY and use Application Default Credentials:
#     - Local dev: run `gcloud auth application-default login` once
#     - Cloud Run: attach a service account to the service; runtime metadata
#       server provides creds. No env var needed.
#
# Fallback (only if org policy allows SA keys):
#   Download service-account.json from Firebase Console > Service Accounts,
#   then `base64 -w0 < service-account.json` and paste the one-line output below.
# ──────────────────────────────────────────────────────────────
FIREBASE_ADMIN_PRIVATE_KEY_JSON=

# ──────────────────────────────────────────────────────────────
# Observability — Sentry
# SENTRY_DSN / SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN
#   are server-only; set in Cloud Run env vars and Secret Manager.
# NEXT_PUBLIC_SENTRY_DSN / NEXT_PUBLIC_SENTRY_ENVIRONMENT
#   are baked into the client bundle at build time.
# SENTRY_ENVIRONMENT is the Node.js runtime label (production / staging).
# ──────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ──────────────────────────────────────────────────────────────
# GCS bucket for Firestore daily exports (Phase 9).
# ──────────────────────────────────────────────────────────────
BACKUP_BUCKET=

# ──────────────────────────────────────────────────────────────
# Google Drive sync (optional — omit GOOGLE_DRIVE_ROOT_FOLDER_ID to disable)
#
# Auth priority: OAuth2 user creds > SA key > ADC.
# For personal My Drive, OAuth2 is required (SA keys have no storage quota).
#
# OAuth2 setup (one-time):
#   1. GCP Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      (Desktop app) → download JSON to .secrets/
#   2. Run: node scripts/get-drive-token.mjs .secrets/client_secret_*.json
#   3. Paste the printed CLIENT_ID / CLIENT_SECRET / REFRESH_TOKEN below.
#
# Folder setup:
#   1. Create a folder in your Google Drive (personal or Shared Drive).
#   2. Copy the folder ID from the URL (/folders/<ID>).
# ──────────────────────────────────────────────────────────────
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# SA key alternative (only works with Shared Drives, not personal My Drive):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
