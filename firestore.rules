rules_version = '2';

// Placeholder rules — proper implementation in Phase 2+ per plan.md §4.4.
// During Phase 0 we deny all client writes by default; server actions use Admin SDK
// which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
